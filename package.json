{
  "name": "client-api-toolkit",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for api-response-tsjs (server) and client-api-kit (client) - shared, type-safe API contract for Node/Express/Fastify/Hono servers and React/Next.js clients.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:node_modules": "rm -rf packages/**/node_modules",
    "release": "turbo run release",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3"
  }
}

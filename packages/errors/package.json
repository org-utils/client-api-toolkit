{
  "name": "client-api-errors",
  "version": "0.0.6",
  "description": "Framework-agnostic application and HTTP error primitives for Node.js and TypeScript applications.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Anwar <anwarkamal1434@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/org-utils/api-toolkit.git",
    "directory": "packages/errors"
  },
  "homepage": "https://github.com/org-utils/api-toolkit/tree/main/packages/errors#readme",
  "bugs": {
    "url": "https://github.com/org-utils/api-toolkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "client-api-types": "workspace:*",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build:js": "tsup",
    "build:types": "rollup --config rollup.dts.config.ts",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release": "npm run build"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}

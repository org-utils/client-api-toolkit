{
  "name": "client-api-types",
  "version": "0.0.8",
  "description": "Shared TypeScript types and utilities for JavaScript and TypeScript applications.",
  "keywords": [
    "typescript",
    "types",
    "utilities",
    "javascript",
    "shared",
    "library"
  ],
  "license": "MIT",
  "author": "Anwar Kamal",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.d.ts"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.d.ts"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.d.ts"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "npm run typecheck && npm run clean && npm run build:types",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "release": "npm run build"

  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "axios": "^1.19.0",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/org-utils/api-toolkit.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/org-utils/api-toolkit/issues"
  },
  "homepage": "https://github.com/org-utils/api-toolkit/tree/main/packages/types#readme"
}
